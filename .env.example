# Base de datos (en Northflank: copia la cadena de conexión del addon PostgreSQL)
DATABASE_URL=postgres://usuario:clave@host:5432/base
DB_SSL=false

# Seguridad: una cadena larga y aleatoria (ej. salida de: openssl rand -hex 32)
JWT_SECRET=cambia-esto-por-un-valor-largo-y-aleatorio

# URL pública de la app, sin barra final (se usa en emails y en el enlace del llavero)
APP_URL=https://tu-dominio.com

# Cuenta de administrador (se crea sola al iniciar)
ADMIN_USER=JalilAlegre
ADMIN_EMAIL=tu-email@ejemplo.com
ADMIN_PASSWORD=una-contraseña-segura

# Envío de emails por SMTP (Brevo, Resend, Gmail con clave de app, etc.)
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=587
SMTP_USER=usuario
SMTP_PASS=clave
MAIL_FROM="VamosRapido <no-responder@tu-dominio.com>"
